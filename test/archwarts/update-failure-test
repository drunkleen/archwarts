#!/usr/bin/env bash
set -euo pipefail
root=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../..")
test_root=$(mktemp -d)
trap 'rm -rf "$test_root"' EXIT

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

export HOME="$test_root/home"
export XDG_CONFIG_HOME="$test_root/config"
export XDG_DATA_HOME="$test_root/data"
export XDG_STATE_HOME="$test_root/state"
export XDG_CACHE_HOME="$test_root/cache"
export XDG_RUNTIME_DIR="$test_root/run"
for d in home config data state cache run; do mkdir -p "$test_root/$d"; done

cli="$root/bin/archwarts"
bin_dir="$test_root/bin"
mkdir -p "$bin_dir"

# Mock curl: controllable network failure.
cat >"$bin_dir/curl" <<'STUB'
#!/usr/bin/env bash
exit "${FIXTURE_CURL_EXIT:-0}"
STUB
# Mock pacman: records invocations; -Syu exit controlled; -Qqm/-Qdt answers.
cat >"$bin_dir/pacman" <<'STUB'
#!/usr/bin/env bash
echo "pacman $*" >>"$FIXTURE_PACMAN_LOG"
case "$1" in
  -Syu) exit "${FIXTURE_SYSU_EXIT:-0}" ;;
  -Qqm) exit 0 ;;
  -Qdt) exit 0 ;;
  *) exit 0 ;;
esac
STUB
cat >"$bin_dir/systemctl" <<'STUB'
#!/usr/bin/env bash
if [[ ${1:-} == --failed ]]; then exit 1; fi
exit 0
STUB
cat >"$bin_dir/sudo" <<'STUB'
#!/usr/bin/env bash
exec "$@"
STUB
chmod +x "$bin_dir/curl" "$bin_dir/pacman" "$bin_dir/systemctl" "$bin_dir/sudo"
export FIXTURE_PACMAN_LOG="$test_root/pacman.log"
export FIXTURE_CURL_EXIT=0
export FIXTURE_SYSU_EXIT=0

update_dir="$test_root/state/archwarts/update"

# --- 1. network loss: preflight fails; update aborts before any pacman -Syu ---
FIXTURE_CURL_EXIT=1 PATH="$bin_dir:$PATH" "$cli" update preflight >"$test_root/preflight.txt" 2>&1 \
  || true
rg -q '^network\tfail\t' "$test_root/preflight.txt" \
  || fail 'preflight must report network failure'
: >"$FIXTURE_PACMAN_LOG"
if FIXTURE_CURL_EXIT=1 PATH="$bin_dir:$PATH" "$cli" update run >/dev/null 2>&1; then
  fail 'update run must fail when the network is down'
fi
if rg -q '^pacman -Syu' "$FIXTURE_PACMAN_LOG"; then
  fail 'update run must not invoke pacman -Syu when preflight fails'
fi

# --- 2. unavailable package / failed upgrade: official recorded failed ---
: >"$FIXTURE_PACMAN_LOG"
FIXTURE_CURL_EXIT=0 FIXTURE_SYSU_EXIT=1 PATH="$bin_dir:$PATH" \
  ARCHWARTS_UPDATE_EXECUTE=1 ARCHWARTS_UPDATE_INHIBIT=0 "$cli" update official >/dev/null 2>&1 \
  || true
[[ $(cut -f2 "$update_dir/last-official.tsv") == failed ]] \
  || fail 'official failure must be recorded as failed'
[[ -s "$update_dir/log" ]] || fail 'failed upgrade must leave a durable log'

# --- 3. failed migration: not recorded applied, update reports failure ---
mkdir -p "$test_root/migrations"
cat >"$test_root/migrations/10-fail.sh" <<'EOF'
#!/usr/bin/env bash
exit 3
EOF
out=$(PATH="$bin_dir:$PATH" ARCHWARTS_UPDATE_EXECUTE=1 \
  ARCHWARTS_MIGRATIONS_ROOT="$test_root/migrations" "$cli" update migrations || true)
rg -q 'migration\tfailed' <<<"$out" || fail 'failed migration must be reported'
rg -q '^10-fail\.sh\t' "$update_dir/migrations-applied.tsv" 2>/dev/null \
  && fail 'failed migration must not be recorded as applied' || true

# --- 4. interrupted update: lock exists; a second run reports the lock ---
"$cli" update status >"$test_root/status.txt" 2>&1 || true
rg -q 'lock' "$test_root/status.txt" || fail 'update status must report lock presence'

# --- 5. AUR failure independent (regression) ---
PATH="$bin_dir:$PATH" ARCHWARTS_UPDATE_EXECUTE=1 ARCHWARTS_AUR_HELPER=nonexistent \
  "$cli" update aur >/dev/null 2>&1 || true
[[ $(cut -f2 "$update_dir/last-official.tsv") == failed ]] \
  || fail 'official status must persist independently of the AUR phase'

printf 'PASS: Archwarts update failure recovery\n'