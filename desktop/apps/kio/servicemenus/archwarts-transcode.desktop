# Dolphin service menu: transcode the selected video files to H.264 MP4 in
# place using ffmpeg.
[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=video/*;
Actions=transcode

[Desktop Action transcode]
Name=Transcode to MP4 (H.264)
Icon=video-x-generic
Exec=bash -c 'for f in "$@"; do ffmpeg -n -i "$f" -c:v libx264 -preset medium -crf 23 -c:a aac "${f%.*}.mp4"; done' bash %F